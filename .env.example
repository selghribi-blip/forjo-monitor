# ---------------------------------------------------------------------------
# forjo-monitor configuration
# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# ---------------------------------------------------------------------------

# --- Site under audit -------------------------------------------------------
# The public base URL of the blog (no trailing slash).
SITE_BASE_URL=https://www.forjo.tech
# Extra hostnames that belong to the same site (for internal-link detection).
SITE_EXTRA_HOSTS=

# --- MongoDB Atlas (free M0 tier) ------------------------------------------
# Atlas -> Connect -> Drivers -> "SRV Connection String".
# URL-encode special characters in the password (@ becomes %40, # becomes %23 ...).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=forjo_monitor

# --- Ad networks to verify --------------------------------------------------
# Comma-separated domain fragments that must be present in the page <script> src
# or <iframe> src for an ad slot to count as "loaded".
AD_NETWORK_DOMAINS=adsterra.com,monetag.com,highperformanceformat.com,profitableratecpm.com

# --- Telegram alerts (optional) --------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Crawler behaviour ------------------------------------------------------
# Be a good citizen: keep this low. The auditor only crawls the site owner's
# own property and honours robots.txt.
CRAWL_CONCURRENCY=2
CRAWL_DELAY_SECONDS=2.0
CRAWL_MAX_PAGES=300
CRAWL_RESPECT_ROBOTS=true

# --- Browser auditing (optional) -------------------------------------------
# Set to "false" to run a fast, HTTP-only audit (skips Core Web Vitals and
# ad-slot visibility checks, which require a real browser).
BROWSER_AUDIT_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
# Directory where failure screenshots are written.
ARTIFACTS_DIR=artifacts

# --- Reporting --------------------------------------------------------------
REPORTS_DIR=reports
# Emit a Telegram alert when the number of failing checks strictly increases
# compared with the previous stored run.
ALERT_ON_REGRESSION=true
